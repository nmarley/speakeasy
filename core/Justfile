set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

# List available commands
default:
    @just --list

# Run cargo fmt
fmt:
    cargo fmt

# Run cargo check
check:
    cargo check

# Run tests
test:
    cargo test

# Build static library (arm64 only -- MLX requires Apple Silicon)
build:
    cargo build --release --target aarch64-apple-darwin
    mkdir -pv target/release
    cp target/aarch64-apple-darwin/release/libspeakeasy_core.a \
        target/release/libspeakeasy_core.a

# Clean build artifacts
clean:
    cargo clean
